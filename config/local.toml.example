[app]
name = "KovaGo"
environment = "local"

[log]
level = "debug"
format = "text"
add_source = true

[log.file]
enabled = true
path = "logs/kovago.log"
format = "json"

[database]
url = "postgres://kovago:kovago@localhost:5432/kovago?sslmode=disable"

max_open_connections = 20
max_idle_connections = 10

connection_max_lifetime = "30m"
connection_max_idle_time = "5m"
ping_timeout = "5s"
